# Ported from render.yaml. Keep the two files in step until Render is retired.

# Vite fingerprints everything under /assets, so the filename changes whenever
# the bytes do. Safe to cache for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(self), payment=(), usb=()
  Content-Security-Policy: default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; form-action 'none'; script-src 'self' 'unsafe-inline' https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; connect-src 'self' https://api.open-meteo.com https://marine-api.open-meteo.com https://proxy.transport.data.gouv.fr https://data.capatlantique.fr https://data.loire-atlantique.fr https://www.google-analytics.com https://region1.google-analytics.com https://analytics.google.com; frame-src 'self'; manifest-src 'self'; worker-src 'self' blob:
